datasource db {
  provider = "postgresql"
 }

generator client {
  provider = "prisma-client-js"
}

model Empregado {
  id_empregado String   @id @default(uuid())
  ds_nome      String
  ds_email     String   @unique
  ds_cpf       String  
  ds_password  String 
  role         String @default("USER")
  dt_nascimento DateTime
  ds_profissao String
  vl_salario   Float
  dt_admissao  DateTime @default(now())
  dt_transacao DateTime @default(now())

  demandas     Demanda[]

  projeto EmpregadoProjeto[]
  
  @@index([ds_nome])
  @@index([ds_email])
}

model Projeto {
  id_projeto    String     @id @default(uuid())
  ds_nome       String
  ds_descricao  String
  orcamento     Float
  dt_inicio     DateTime
  dt_fim        DateTime
  dt_transacao  DateTime   @default(now())

  empregados    EmpregadoProjeto[]
  demandas      Demanda[]

  @@index([ds_nome])
}

model Demanda {
  id_demanda   String    @id @default(uuid())
  id_projeto   String
  id_empregado String
  ds_nome      String
  ds_descricao String
  dt_inicio    DateTime
  dt_fim       DateTime
  dt_transacao DateTime @default(now())     

  projeto      Projeto   @relation(fields: [id_projeto], references: [id_projeto])
  empregado    Empregado @relation(fields: [id_empregado], references: [id_empregado])
}

model EmpregadoProjeto {
  id String @id @default(uuid())
  id_empregado String 
  id_projeto String 

  empregado Empregado @relation(fields: [id_empregado], references: [id_empregado])
  projeto Projeto @relation(fields: [id_projeto], references: [id_projeto])

  @@unique([id_empregado, id_projeto])
}